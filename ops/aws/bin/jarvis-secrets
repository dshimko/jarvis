#!/usr/bin/env python3
"""jarvis-secrets: root oneshot tool. Subcommands: `sync`, `publish-token <mode>`.

infra/DESIGN.md section 5; PLAN.md AD7, AD31. Runs as root but never opens a path under
/home/jarvis-<mode> directly: writes go through `runuser -u jarvis-<mode> --
/opt/jarvis/libexec/jarvis-write-env`, and the token read for publish-token goes through
`runuser -u jarvis-<mode> -- cat ...`. A symlink planted by a compromised mode user can then
only ever reach files that user already owns.

Uses the AWS CLI via subprocess rather than boto3 in a dedicated venv: the CLI is already
installed system-wide for cloud-init's own use (infra/DESIGN.md section 6.4), so this avoids
maintaining a second Python environment purely to make two kinds of Secrets Manager calls.

Never logs secret values. Violations are reported by key name only, never by value.
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import time

REGION_FILE = "/etc/jarvis/region"
KEY_RE = re.compile(r"^[A-Z][A-Z0-9_]{0,63}$")
CRLF_RE = re.compile(r"[\r\n]")
MODES = ("work", "personal")
SECRET_NAMES = {"work": "jarvis/work", "personal": "jarvis/personal", "shared": "jarvis/shared"}
TOKEN_SECRET_NAMES = {"work": "jarvis/work/api-token", "personal": "jarvis/personal/api-token"}
HASH_DIR = "/var/lib/jarvis-secrets"
TOKEN_WAIT_TIMEOUT_S = 30
APP_ROOT = "/opt/jarvis/current"
MCP_FILES = {"work": "work.mcp.json", "personal": "personal.mcp.json"}
MCP_MIN_LITERAL_LEN = 8


def log(msg: str) -> None:
    print(f"[jarvis-secrets] {msg}", flush=True)


def log_event(event: str, mode: str, **fields) -> None:
    """JSON-line log for anything that runs inside jarvis@<mode>'s own journal (ExecStartPost),
    so jarvis-logfilter forwards it instead of silently counting it as nonjson_dropped (M10)."""
    payload = {"event": event, "mode": mode}
    payload.update(fields)
    print(json.dumps(payload), flush=True)


def region() -> str:
    """AD34: region literals leave every script. JARVIS_REGION (env) wins; otherwise fall back to
    the file user_data.sh.tftpl writes before bootstrap.sh runs. Fails loudly if both are empty."""
    value = os.environ.get("JARVIS_REGION", "").strip()
    if not value and os.path.exists(REGION_FILE):
        with open(REGION_FILE, encoding="utf-8") as f:
            value = f.read().strip()
    if not value:
        raise RuntimeError(
            f"AWS region is not set: no JARVIS_REGION env var and no {REGION_FILE}"
        )
    return value


def get_secret_json(name: str, aws_region: str):
    """Returns the parsed secret value dict, or None if it has no version yet."""
    proc = subprocess.run(
        ["aws", "secretsmanager", "get-secret-value", "--secret-id", name,
         "--query", "SecretString", "--output", "text", "--region", aws_region],
        capture_output=True, text=True, check=False,
    )
    if proc.returncode != 0:
        if "ResourceNotFoundException" in proc.stderr:
            return None
        raise RuntimeError(f"get-secret-value failed for a secret (exit {proc.returncode})")
    value = json.loads(proc.stdout)
    if not isinstance(value, dict):
        raise RuntimeError("secret value is not a JSON object")
    return value


def validate_keys(values: dict) -> list:
    """M5: rejects a bad key format, a non-string value, or a value containing CR or LF.
    Returns key names only, never values."""
    bad = []
    for k, v in values.items():
        if not KEY_RE.match(k) or not isinstance(v, str) or CRLF_RE.search(v):
            bad.append(k)
    return sorted(set(bad))


def shared_violations_source():
    """Prefer the app's own copy so the two never drift silently out of sync. Returns
    (function, source_label); the caller logs the label either way.

    M4: jarvis.secrets_check currently imports dotenv at module scope (app-engineer is making
    that lazy), which can fail to import outside the app's own venv -- ImportError (its parent,
    ModuleNotFoundError, included) falls back to the inline copy either way."""
    sys.path.insert(0, "/opt/jarvis/current")
    try:
        from jarvis.secrets_check import shared_violations  # type: ignore
        return shared_violations, "jarvis.secrets_check"
    except ImportError:
        return _inline_shared_violations, "inline_fallback"


def _inline_shared_violations(work: dict, personal: dict, shared_keys, *, exempt_prefixes=()) -> list:
    """Inline fallback copy of jarvis.secrets_check.shared_violations(work, personal, shared_keys,
    *, exempt_prefixes=()). Keep this identical to that function's semantics: a violation is any
    value that appears in both `work` and `personal`, whether under the same key name or
    different ones (comparison is over all key pairs, not just matching keys); keys in
    `shared_keys` are skipped entirely on both sides; empty values are skipped entirely (M4:
    `if v`) so two coincidentally-blank entries never compare equal. `exempt_prefixes` is
    accepted for interface parity only -- jarvis-secrets on AWS never passes it (that exemption
    is for the local CLI). Returns key names only, never values. This function does NOT enforce
    DESIGN.md section 5 rule 2 (a mode key that also exists in jarvis/shared); see
    shadowed_shared_keys() below, which the caller runs separately, matching
    jarvis.secrets_check's own scope."""
    def usable(items):
        return {
            k: v for k, v in items.items()
            if v and k not in shared_keys and not any(k.startswith(p) for p in exempt_prefixes)
        }

    work_u, personal_u = usable(work), usable(personal)
    violations = set()
    for wk, wv in work_u.items():
        for pk, pv in personal_u.items():
            if wv == pv:
                violations.add(wk)
                violations.add(pk)
    return sorted(violations)


def shadowed_shared_keys(work: dict, personal: dict, shared_keys) -> list:
    """DESIGN.md section 5 rule 2: a mode key that also exists in jarvis/shared is a violation.
    jarvis.secrets_check.shared_violations does not implement this rule, so jarvis-secrets
    enforces it itself, before calling shared_violations."""
    return sorted(k for k in shared_keys if k in work or k in personal)


def mcp_literal_violations_source():
    """Same preference order as shared_violations_source(): the app's own copy first."""
    sys.path.insert(0, "/opt/jarvis/current")
    try:
        from jarvis.secrets_check import mcp_literal_violations  # type: ignore
        return mcp_literal_violations, "jarvis.secrets_check"
    except ImportError:
        return _inline_mcp_literal_violations, "inline_fallback"


def _inline_mcp_literal_violations(root, work_env: dict, personal_env: dict) -> list:
    """Inline fallback copy of jarvis.secrets_check.mcp_literal_violations(root, work_env,
    personal_env) -- same parameter order and meaning: `root` is the app root (the parent of
    mcp/), not the mcp/ directory itself. Flags any secret value (len >= 8, from either mode's
    env) that appears literally inside an MCP config file's raw text -- a hardcoded secret where
    the file should hold an ${ENV_VAR} placeholder instead. Returns "mcp/<file>: <KEY>" strings,
    never values."""
    candidates = {}
    for env in (work_env, personal_env):
        for k, v in env.items():
            if isinstance(v, str) and len(v) >= MCP_MIN_LITERAL_LEN:
                candidates.setdefault(v, k)

    hits = []
    for filename in MCP_FILES.values():
        path = os.path.join(str(root), "mcp", filename)
        if not os.path.isfile(path):
            continue
        with open(path, encoding="utf-8") as f:
            content = f.read()
        for value, key in candidates.items():
            if value in content:
                hits.append(f"mcp/{filename}: {key}")
    return sorted(hits)


def write_env(mode: str, merged: dict) -> None:
    body = "".join(f"{k}={v}\n" for k, v in sorted(merged.items()))
    user = f"jarvis-{mode}"
    proc = subprocess.run(
        ["runuser", "-u", user, "--", "/opt/jarvis/libexec/jarvis-write-env"],
        input=body, text=True, capture_output=True, check=False,
    )
    if proc.returncode != 0:
        raise RuntimeError(f"jarvis-write-env failed for {mode} (exit {proc.returncode})")


def cmd_sync() -> int:
    aws_region = region()
    fetched = {}
    for mode in ("work", "personal", "shared"):
        value = get_secret_json(SECRET_NAMES[mode], aws_region)
        if value is None:
            log(f"secrets_unpopulated name={SECRET_NAMES[mode]}")
            return 1
        fetched[mode] = value

    work, personal, shared = fetched["work"], fetched["personal"], fetched["shared"]
    for mode, values in (("work", work), ("personal", personal), ("shared", shared)):
        bad = validate_keys(values)
        if bad:
            log(f"secret_invalid_keys mode={mode} keys={','.join(bad)}")
            return 1

    shared_keys = frozenset(shared)
    violations = set(shadowed_shared_keys(work, personal, shared_keys))
    fn, source = shared_violations_source()
    log(f"shared_violations_source={source}")
    violations.update(fn(work, personal, shared_keys))
    if violations:
        log(f"shared_violation keys={','.join(sorted(violations))}")
        return 1

    merged_work = {**shared, **work}
    merged_personal = {**shared, **personal}

    mcp_fn, mcp_source = mcp_literal_violations_source()
    log(f"mcp_literal_violations_source={mcp_source}")
    mcp_hits = mcp_fn(APP_ROOT, merged_work, merged_personal)
    if mcp_hits:
        for hit in mcp_hits:
            log(f"mcp_literal_violation {hit}")
        return 1

    write_env("work", merged_work)
    write_env("personal", merged_personal)
    log("sync complete modes=work,personal")
    return 0


def cmd_publish_token(mode: str) -> int:
    if mode not in MODES:
        log(f"unknown mode {mode}")
        return 1
    user = f"jarvis-{mode}"
    deadline = time.monotonic() + TOKEN_WAIT_TIMEOUT_S
    token = None
    # H3: keep retrying for up to 30s while the file is missing OR its content is not yet a
    # valid 64-hex token (the daemon may still be writing it when ExecStartPost fires), not just
    # while the file is absent.
    while time.monotonic() < deadline:
        proc = subprocess.run(
            ["runuser", "-u", user, "--", "cat", f"/home/{user}/.jarvis/api_token"],
            capture_output=True, text=True, check=False,
        )
        if proc.returncode == 0:
            candidate = proc.stdout.strip()
            if re.fullmatch(r"[0-9a-f]{64}", candidate):
                token = candidate
                break
        time.sleep(1)
    if token is None:
        log_event("token_publish_failed", mode, error_class="TokenMissingOrMalformed")
        return 1

    digest = hashlib.sha256(token.encode("ascii")).hexdigest()
    os.makedirs(HASH_DIR, mode=0o700, exist_ok=True)
    hash_path = os.path.join(HASH_DIR, f"{mode}.token.sha256")
    previous = None
    if os.path.exists(hash_path):
        with open(hash_path, encoding="utf-8") as f:
            previous = f.read().strip()
    if previous == digest:
        log_event("token_unchanged", mode)
        return 0

    proc = subprocess.run(
        ["aws", "secretsmanager", "put-secret-value", "--secret-id", TOKEN_SECRET_NAMES[mode],
         "--secret-string", "file:///dev/stdin", "--region", region()],
        input=token, capture_output=True, text=True, check=False,
    )
    if proc.returncode != 0:
        log_event("token_publish_failed", mode, error_class="PutSecretValueFailed")
        return 1

    with open(hash_path, "w", encoding="utf-8") as f:
        f.write(digest + "\n")
    os.chmod(hash_path, 0o600)
    log_event("token_published", mode)
    return 0


def main(argv) -> int:
    if len(argv) >= 2 and argv[1] == "sync":
        return cmd_sync()
    if len(argv) == 3 and argv[1] == "publish-token":
        return cmd_publish_token(argv[2])
    log("usage: jarvis-secrets sync|publish-token <mode>")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
