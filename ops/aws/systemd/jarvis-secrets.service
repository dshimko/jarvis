[Unit]
Description=Sync Jarvis Secrets Manager values into per-mode env files
After=jarvis-imds-guard.service network-online.target
Wants=network-online.target
Requires=jarvis-imds-guard.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/jarvis/bin/jarvis-secrets sync

[Install]
WantedBy=multi-user.target
