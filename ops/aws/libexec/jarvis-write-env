#!/usr/bin/env python3
"""jarvis-write-env: writes KEY=value stdin content to ~/.jarvis/env atomically.

infra/DESIGN.md section 5, rule 4. Runs as the mode user (invoked via
`runuser -u jarvis-<mode> --` by root's `jarvis-secrets sync`; PLAN.md AD31: root never opens a
path inside a mode user's home directly). Opens the temp file with
O_CREAT|O_EXCL|O_NOFOLLOW|O_WRONLY so a symlink planted at env.tmp can only ever point at
something this user already owns.
"""
import os
import sys


def main() -> int:
    home = os.path.expanduser("~")
    jarvis_dir = os.path.join(home, ".jarvis")
    os.makedirs(jarvis_dir, mode=0o700, exist_ok=True)
    tmp_path = os.path.join(jarvis_dir, "env.tmp")
    final_path = os.path.join(jarvis_dir, "env")

    data = sys.stdin.buffer.read()

    flags = os.O_CREAT | os.O_EXCL | os.O_WRONLY | os.O_NOFOLLOW
    try:
        fd = os.open(tmp_path, flags, 0o600)
    except FileExistsError:
        # Stale temp file from a previous failed run; this user owns it either way.
        os.unlink(tmp_path)
        fd = os.open(tmp_path, flags, 0o600)

    try:
        with os.fdopen(fd, "wb") as f:
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.rename(tmp_path, final_path)
        os.chmod(final_path, 0o600)
    except BaseException:
        try:
            os.unlink(tmp_path)
        except FileNotFoundError:
            pass
        raise
    return 0


if __name__ == "__main__":
    sys.exit(main())
