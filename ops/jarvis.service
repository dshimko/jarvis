[Unit]
Description=Jarvis headless daemon
After=network-online.target

[Service]
WorkingDirectory=__JARVIS_DIR__
ExecStart=__JARVIS_DIR__/.venv/bin/python -m jarvis.main --headless
Restart=always
RestartSec=5
TimeoutStopSec=30
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=LANG=C.UTF-8
Environment=PYTHONUNBUFFERED=1
UMask=0077

[Install]
WantedBy=default.target
